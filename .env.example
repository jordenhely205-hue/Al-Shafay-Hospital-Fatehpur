# ==============================================================================
# Al-Shafay Hospital Fatehpur (HMS) - Production Environment Configuration
# ==============================================================================

# Cloud Database Connection String (Supabase, Neon, Railway, or AWS RDS PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
# If omitted, system will automatically fallback to local persistent file storage.
DATABASE_URL=postgresql://postgres.your-supabase-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Secret Key for Staff & Super Admin Authentication Sessions
JWT_SECRET=al-shafay-hospital-secret-key-2026-production

# Server Port (Only used in local Node standalone mode; Vercel automatically sets port)
PORT=5000

# Environment Mode
NODE_ENV=production
